rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True only for the portfolio owner, signed in with Google
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "brightkakatech@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // A non-empty piece of text no longer than max characters
    function isText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    // Messages: anyone may send one; only the owner may read or delete them
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(["name", "text", "time"])
        && isText(request.resource.data.name, 50)
        && isText(request.resource.data.text, 1000)
        && request.resource.data.time == request.time;
      allow read, delete: if isOwner();
    }

    // Blog posts: anyone may read; signed-in users with a verified email may publish.
    // Authors may delete their own posts; the owner may delete any (moderation).
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.token.email_verified == true // stops unverified (possibly fake) accounts posting
        && request.resource.data.keys().hasOnly(["title", "content", "date", "authorId", "authorName"])
        && isText(request.resource.data.title, 150)
        && isText(request.resource.data.content, 10000)
        && request.resource.data.date == request.time
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == request.auth.token.name;
      allow delete: if isOwner()
        || (request.auth != null && resource.data.authorId == request.auth.uid);
    }
  }
}